+void Solver::openBcpLog(const char* path)
+{
+    bcp_log = fopen(path, "w");
+    if (!bcp_log) { perror("BCP log"); exit(1); }
+    fprintf(bcp_log, "call_id,phase,pending_entries,decision_level,decisions_before,propagations_before,trail_before,status,processed_entries,implied_assignments,decisions_after,propagations_after,trail_after,kernel_ns,observed_ns_before_write\n");
+}
+
+void Solver::closeBcpLog()
+{
+    if (bcp_log) {
+        bool failed = ferror(bcp_log);
+        if (fclose(bcp_log) != 0) failed = true;
+        bcp_log = NULL;
+        if (failed) { fprintf(stderr, "BCP log write failed\n"); exit(1); }
+    }
+}
+
 CRef Solver::propagate()
+{
+    if (!bcp_log) return propagateOriginal();
+    typedef std::chrono::steady_clock Clock;
+    const Clock::time_point begin = Clock::now();
+    const int pending = trail.size() - qhead;
+    const int level_before = decisionLevel();
+    const int trail_before = trail.size();
+    const uint64_t decisions_before = decisions;
+    const uint64_t props_before = propagations;
+    const Clock::time_point kernel_begin = Clock::now();
+    const CRef result = propagateOriginal();
+    const Clock::time_point kernel_end = Clock::now();
+    const uint64_t kernel_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(kernel_end - kernel_begin).count();
+    const uint64_t observed_ns = std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now() - begin).count();
+    fprintf(bcp_log, "%llu,%s,%d,%d,%llu,%llu,%d,%s,%llu,%d,%llu,%llu,%d,%llu,%llu\n",
+        (unsigned long long)++bcp_call, bcp_phase, pending, level_before,
+        (unsigned long long)decisions_before, (unsigned long long)props_before,
+        trail_before, result == CRef_Undef ? "FIXED_POINT" : "CONFLICT",
+        (unsigned long long)(propagations - props_before), trail.size() - trail_before,
+        (unsigned long long)decisions, (unsigned long long)propagations, trail.size(),
+        (unsigned long long)kernel_ns, (unsigned long long)observed_ns);
+    return result;
+}
